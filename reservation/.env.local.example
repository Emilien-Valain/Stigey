# Copier en .env.local (déjà gitignoré) pour le développement local.
# Valeurs Supabase imprimées par `npm run db:test:start` (= `supabase start`) —
# stables tant que supabase/config.toml n'est pas modifié.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0

# Utilisé uniquement par le cron des rappels (src/app/api/cron/rappels),
# jamais par une requête utilisateur : contourne RLS. Ne JAMAIS exposer côté
# client (pas de préfixe NEXT_PUBLIC_).
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzgxMjk5Nn0.EGIM96RAZx35lJzdJsyH-qQwv8Hdp7fsn3W0YpN81IU

# Email transactionnel (ADR-0004) — compte Resend à créer, laisser vide en
# attendant : les fonctions d'envoi deviennent alors des no-op (voir
# src/lib/notify/resend.ts), aucune réservation n'est bloquée pour autant.
RESEND_API_KEY=
# Adresse d'expédition (nécessite un domaine vérifié sur Resend en prod ; le
# domaine de test onboarding@resend.dev fonctionne uniquement pour envoyer à
# l'adresse du compte Resend lui-même).
RESEND_FROM_EMAIL="Stigey <reservations@stigey.fr>"

# Identité de la praticienne pour l'ORGANIZER de l'invitation .ics — doit
# correspondre à une adresse qu'elle relève réellement (Gmail/Apple Mail y
# ajoute l'évènement à son propre agenda en tant qu'organisatrice).
PRATICIENNE_EMAIL=praticienne@stigey.fr
PRATICIENNE_NOM="Sonia Bah"

# Secret partagé avec Vercel Cron pour /api/cron/rappels (voir vercel.json).
# Vercel envoie automatiquement `Authorization: Bearer $CRON_SECRET` dès que
# cette variable est définie dans les réglages du projet Vercel — générer une
# chaîne aléatoire d'au moins 16 caractères.
CRON_SECRET=
